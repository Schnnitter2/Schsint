# Telegram BotFather token; required to run the bot.
BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to scan and inspect history.
# Empty means scan/history operations are denied for everyone.
ADMIN_IDS=
DATABASE_URL=sqlite+aiosqlite:///data/schsint.db
DATA_DIR=data
RATE_LIMIT_PER_HOUR=5
